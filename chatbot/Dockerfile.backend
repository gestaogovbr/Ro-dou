FROM python:3.12-slim

WORKDIR /app

COPY chatbot/requirements.txt /app/chatbot/requirements.txt
RUN pip install --no-cache-dir -r /app/chatbot/requirements.txt

COPY chatbot /app/chatbot

ENV PYTHONPATH=/app/chatbot
ENV RO_DOU_CHAT_CONFIG=/app/chatbot/config.example.yaml
EXPOSE 8001

CMD ["uvicorn", "rodou_chatbot.app:app", "--host", "0.0.0.0", "--port", "8001"]
