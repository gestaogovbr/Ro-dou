# Copie para deploy/prod/.env.production, preencha e proteja:
#
#   cp deploy/prod/.env.production.example deploy/prod/.env.production
#   chmod 600 deploy/prod/.env.production
#
# NUNCA versione o .env.production.
# Valores com #, $ ou espaços devem ficar entre aspas simples.

COMPOSE_PROJECT_NAME=ro-dou

# URL pública do Airflow, sem barra no final.
RO_DOU_PUBLIC_URL=https://rodou.exemplo.gov.br
RO_DOU_HOST=rodou.exemplo.gov.br

# Porta local usada apenas quando NÃO se usa o arquivo do Traefik.
AIRFLOW_HTTP_PORT=8080

# Admin criado na primeira inicialização do banco.
# Se o banco já existe, a senha não é alterada automaticamente.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Banco do Airflow. Use senha URL-safe (hex) para não quebrar a URI.
# Gere com: openssl rand -hex 24
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=troque-por-hex-de-24-bytes
AIRFLOW_DB_NAME=airflow

# Gere a chave Fernet com:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=troque-pela-chave-fernet
# Gere cada segredo com: openssl rand -hex 32
AIRFLOW_WEBSERVER_SECRET_KEY=troque-pelo-secret-key
AIRFLOW_API_JWT_SECRET=troque-pelo-jwt-secret
AIRFLOW_API_SECRET_KEY=troque-pelo-api-secret

AIRFLOW_TIMEZONE=America/Sao_Paulo
AIRFLOW_DAGS_PAUSED=true

# SMTP real. O smtp4dev não sobe no perfil de produção.
SMTP_HOST=smtp.exemplo.gov.br
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=usuario
SMTP_PASSWORD=troque-pela-senha-smtp
SMTP_MAIL_FROM=rodou@exemplo.gov.br

# Conexão usada por send_email/SMTP. Use aspas simples para preservar
# caracteres especiais. Se a senha tiver @, :, /, # ou %, use a forma JSON
# abaixo ou faça URL-encode da senha na URI.
# Alternativa em JSON:
# AIRFLOW_CONN_SMTP_DEFAULT='{"conn_type":"smtp","host":"smtp.exemplo.gov.br","port":587,"login":"usuario","password":"senha","extra":{"from_email":"rodou@exemplo.gov.br"}}'
AIRFLOW_CONN_SMTP_DEFAULT='smtp://usuario:senha@smtp.exemplo.gov.br:587'

# OpenSearch do INLABS. Fica apenas na rede interna, sem porta publicada.
# Use false para o modo SQL no PostgreSQL.
RO_DOU_INLABS_USE_OPENSEARCH=false
OPENSEARCH_USER=admin
# Se habilitar o plugin de segurança, use maiúscula, minúscula, número e símbolo.
OPENSEARCH_PASS=troque-por-senha-forte
# Fixe uma versão validada após o primeiro deploy.
OPENSEARCH_VERSION=2
OPENSEARCH_JAVA_OPTS='-Xms1g -Xmx1g'
OPENSEARCH_MEM_LIMIT=3g

# Limites de memória. Ajuste conforme a VPS e os outros containers.
AIRFLOW_API_MEM_LIMIT=2g
AIRFLOW_SCHEDULER_MEM_LIMIT=2g
AIRFLOW_DAG_PROCESSOR_MEM_LIMIT=1g
POSTGRES_MEM_LIMIT=1g

# Apenas para o docker-compose.traefik.yml.
# TRAEFIK_NETWORK é o nome exato da rede externa do Traefik.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
